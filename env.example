# Configuración AFIP/ARCA Facturación API
# Copia este archivo como .env y configura los valores
# NO subir .env, key.key ni cert.crt al repo

# Entorno (development / production)
NODE_ENV=development

# Puerto del servidor
PORT=5001

# CUIT del emisor (default si el pedido no manda cuit)
# Usar el CUIT del certificado autorizado en ARCA (computador fiscal)
AFIP_CUIT=20123456789

# Punto de venta habilitado en AFIP (default si el pedido no manda ptoVta)
AFIP_PTO_VTA=1

# Opcional: si se define, todos los endpoints exigen header X-Afip-Secret
# AFIP_API_SECRET=cambiar-por-un-secreto-largo
